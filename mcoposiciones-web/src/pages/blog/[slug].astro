---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABanner from '../../components/CTABanner.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
	return posts.map((post) => ({ params: { slug: post.id } }));
}

const slug = Astro.params.slug ?? '';
const entry = await getEntry('blog', slug);

if (!entry || entry.data.draft) {
	return Astro.redirect('/blog/');
}

const { Content } = await render(entry);
const allPosts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const sameCategoryPosts = allPosts
	.filter((post) => post.id !== entry.id && post.data.category === entry.data.category)
	.slice(0, 3);
const fallbackPosts = allPosts.filter((post) => post.id !== entry.id && !sameCategoryPosts.some((relatedPost) => relatedPost.id === post.id));
const relatedPosts = [...sameCategoryPosts, ...fallbackPosts].slice(0, 3);
const categoryLabel = (category: string) =>
	category === 'Preparacion y Estudio' ? 'Preparación y Estudio' : category;
const formatDate = (date: Date) =>
	date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const courseLinks = [
	{ href: '/oposiciones-administrativo-estado/', label: 'Preparación Administrativo del Estado (AGE C1)' },
	{ href: '/oposiciones-seguridad-social/', label: 'Preparación Administrativo de la Seguridad Social' },
	{ href: '/preparar-age-y-seguridad-social/', label: 'Pack AGE + SS' },
];

const canonicalUrl = `https://mcoposiciones.com/blog/${entry.id}/`;
const articleImage = entry.data.image
	? new URL(entry.data.image, 'https://mcoposiciones.com').toString()
	: 'https://mcoposiciones.com/og-default.webp';
const displayDate = entry.data.updatedDate ?? entry.data.pubDate;
const faqSchema = entry.data.faqs?.length
	? {
			'@type': 'FAQPage',
			'@id': `${canonicalUrl}#faq`,
			mainEntity: entry.data.faqs.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		}
	: null;
const schemaJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BlogPosting',
			'@id': `${canonicalUrl}#article`,
			headline: entry.data.h1,
			description: entry.data.description,
			image: articleImage,
			author: {
				'@id': 'https://mcoposiciones.com/preparadora-oposiciones/#person',
			},
			datePublished: entry.data.pubDate.toISOString(),
			dateModified: displayDate.toISOString(),
			publisher: {
				'@id': 'https://mcoposiciones.com/#organization',
			},
			mainEntityOfPage: {
				'@type': 'WebPage',
				'@id': canonicalUrl,
			},
		},
		...(faqSchema ? [faqSchema] : []),
	],
});
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	canonicalUrl={canonicalUrl}
	ogType="article"
	ogImage={entry.data.image}
	schemaJson={schemaJson}
>
	<main class="overflow-x-hidden pt-24">
		<article class="max-w-full overflow-x-hidden px-4 py-16 sm:px-6 lg:px-8">
			<header class="mx-auto max-w-7xl">
				<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: entry.data.h1, href: '' }]} />

				<div class="mt-12 max-w-4xl">
					<p class="text-xs font-extrabold uppercase tracking-[0.18em] text-secondary">{categoryLabel(entry.data.category)}</p>
					<h1 class="mt-4 break-words text-balance text-4xl font-extrabold leading-tight text-primary md:text-6xl">
						{entry.data.h1}
					</h1>
					<p class="mt-6 max-w-3xl break-words text-lg leading-relaxed text-text-muted md:text-xl">{entry.data.excerpt}</p>

					<div class="mt-8 flex items-center gap-5 border-y border-primary/10 py-5">
						<img src="/foto-perfil-blog.webp" alt="Mª Carmen, preparadora de oposiciones AGE y Seguridad Social" width="112" height="112" loading="lazy" decoding="async" class="h-14 w-14 rounded-full border-2 border-white object-cover shadow-sm md:h-16 md:w-16" />
						<div class="flex min-h-14 flex-col justify-center text-sm leading-tight md:min-h-16">
							<p class="m-0 font-bold leading-none text-primary">{entry.data.author}</p>
							<p class="m-0 mt-1 text-text-muted">Actualizado el {formatDate(displayDate)}</p>
						</div>
					</div>

					{entry.data.image && (
						<figure class="mt-10 overflow-hidden rounded-2xl bg-white shadow-premium ring-1 ring-primary/5">
							<img
								src={entry.data.image}
								alt={entry.data.imageAlt}
								width="1200"
								height="630"
								loading="eager"
								fetchpriority="high"
								decoding="async"
								class="aspect-[16/9] w-full object-cover md:aspect-[2/1]"
							/>
						</figure>
					)}
				</div>
			</header>

			<div class="mx-auto mt-12 max-w-7xl">
				<div class="prose prose-premium max-w-4xl">
					<Content />
				</div>

				<section class="mx-auto mt-20 max-w-4xl overflow-hidden rounded-2xl bg-white px-8 py-12 shadow-premium ring-1 ring-primary/5 md:px-12">
					<h2 class="text-center text-2xl font-extrabold text-primary md:text-3xl">Impulsa tu preparación</h2>
					<p class="mx-auto mt-4 max-w-2xl text-center text-text-muted">Formación especializada con Mª Carmen para ordenar tu estudio y avanzar con un plan claro.</p>
					<div class="mt-10 grid gap-5 md:grid-cols-3">
						{courseLinks.map((link) => (
							<a href={link.href} class="flex h-full items-center justify-center rounded-xl bg-bg-light/80 p-5 text-center text-sm font-bold text-primary no-underline ring-1 ring-primary/10 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-secondary hover:ring-secondary/30 active:translate-y-0">
								{link.label}
							</a>
						))}
					</div>
				</section>

				<div class="mx-auto mt-16 max-w-4xl">
					<CTABanner
						title="¿Hablamos sobre tu plaza?"
						subtitle="Cuéntame tu objetivo y te ayudaré a trazar el mejor plan de estudio."
						ctaText="Contactar con Mª Carmen"
						ctaHref="/contacto/"
						variant="primary"
					/>
				</div>
			</div>

			{relatedPosts.length > 0 && (
				<section class="mx-auto mt-24 max-w-6xl pb-20">
					<div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
						<div>
							<p class="text-sm font-semibold tracking-[0.18em] text-secondary">Lecturas relacionadas</p>
							<h2 class="mt-3 text-3xl font-extrabold text-primary">También te puede interesar</h2>
						</div>
						<a href="/blog/" class="text-sm font-black text-secondary no-underline hover:text-accent">Ver todo el blog</a>
					</div>

					<div class="mt-10 grid gap-7 md:grid-cols-3">
						{relatedPosts.map((post) => (
							<a href={`/blog/${post.id}/`} class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white no-underline shadow-premium ring-1 ring-primary/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-premium-hover">
								{post.data.image && (
									<img
										src={post.data.image}
										alt={post.data.imageAlt}
										width="1200"
										height="630"
										loading="lazy"
										decoding="async"
										class="aspect-[40/21] w-full object-cover transition-transform duration-700 group-hover:scale-[1.045]"
									/>
								)}
								<div class="flex flex-1 flex-col p-6">
									<p class="m-0 text-[0.7rem] font-extrabold tracking-[0.16em] text-secondary">{categoryLabel(post.data.category)}</p>
									<h3 class="mt-4 text-lg font-extrabold leading-snug text-primary transition-colors duration-150 ease-out group-hover:text-secondary">{post.data.h1}</h3>
									<span class="mt-auto pt-6 text-xs font-black text-secondary">Leer artículo</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}
		</article>
	</main>
</BaseLayout>
