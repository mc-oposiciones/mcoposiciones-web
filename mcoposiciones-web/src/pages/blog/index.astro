---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { createBlogIndexSchema } from '../../lib/schema';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const [featuredPost, ...regularPosts] = posts;
const categories = [...new Set(posts.map((post) => post.data.category))];
const categorySlug = (category: string) =>
	category
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
const categoryLabel = (category: string) =>
	category === 'Preparacion y Estudio' ? 'Preparación y Estudio' : category;
const formatDate = (date: Date) =>
	date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const schemaJson = JSON.stringify(createBlogIndexSchema(posts));
---

<BaseLayout
	title="Blog oposiciones AGE Seguridad Social | MC Oposiciones"
	description="Blog oposiciones AGE seguridad social con guías de temario, convocatorias, test, supuestos y consejos para preparar C1 online con método. Lee el blog."
	canonicalUrl="https://mcoposiciones.com/blog/"
	ogTitle="Guías para preparar oposiciones AGE y Seguridad Social"
	ogDescription="Consejos claros sobre temario, convocatorias, test, supuestos prácticos y estudio de oposiciones C1."
	schemaJson={schemaJson}
>
	<main class="overflow-x-hidden pt-24">
		<section class="relative px-4 py-16 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-7xl">
				<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Blog', href: '' }]} />

				<header class="mt-10 max-w-5xl">
					<p class="text-xs font-extrabold uppercase tracking-[0.18em] text-secondary">Recursos para estudiar con criterio</p>
					<h1 class="mt-5 text-balance text-3xl font-extrabold leading-[1.08] text-primary sm:text-4xl md:text-6xl">
						Blog oposiciones AGE y Seguridad Social
					</h1>
				</header>

				<nav class="mt-10 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap" aria-label="Filtrar por categoría" data-blog-filters>
					<a href="/blog/" class="rounded-xl border border-primary/10 bg-white/90 px-4 py-2.5 text-center text-xs font-bold text-primary no-underline shadow-premium transition-all duration-300 hover:-translate-y-0.5 hover:border-secondary/40 hover:bg-white hover:text-secondary active:translate-y-0 sm:px-5 sm:text-left sm:text-sm" data-category-filter="all">Todas</a>
					{categories.map((category) => (
						<a href={`/blog/?categoria=${categorySlug(category)}`} class="max-w-full rounded-xl border border-primary/10 bg-white/90 px-4 py-2.5 text-center text-xs font-bold text-primary no-underline shadow-premium transition-all duration-300 hover:-translate-y-0.5 hover:border-secondary/40 hover:bg-white hover:text-secondary active:translate-y-0 sm:px-5 sm:text-left sm:text-sm" data-category-filter={categorySlug(category)}>
							{categoryLabel(category)}
						</a>
					))}
				</nav>

				{featuredPost && (
					<section class="mt-14" aria-label="Artículo destacado">
						<article class="blog-card group grid overflow-hidden rounded-[1.75rem] bg-white shadow-premium ring-1 ring-primary/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-premium-hover lg:grid-cols-[minmax(0,1.28fr)_minmax(19rem,0.72fr)]" data-category={categorySlug(featuredPost.data.category)}>
							<a href={`/blog/${featuredPost.id}/`} class="relative block aspect-[40/21] overflow-hidden bg-bg-dark no-underline" aria-label={`Leer ${featuredPost.data.h1}`}>
								{featuredPost.data.image && (
									<img
										src={featuredPost.data.image}
										alt={featuredPost.data.imageAlt}
										width="1200"
										height="630"
										loading="lazy"
										decoding="async"
										class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
									/>
								)}
								<div class="absolute inset-0 bg-gradient-to-t from-primary/30 via-transparent to-transparent"></div>
							</a>
							<div class="flex flex-col p-7 sm:p-8 lg:p-7 xl:p-8">
								<div class="flex flex-wrap items-center gap-3">
									<span class="rounded-lg bg-secondary/10 px-3 py-1.5 text-xs font-extrabold tracking-[0.16em] text-secondary">{categoryLabel(featuredPost.data.category)}</span>
									<span class="text-sm font-semibold text-text-muted">{formatDate(featuredPost.data.pubDate)}</span>
								</div>
								<h2 class="mt-5 text-balance text-2xl font-extrabold leading-[1.08] text-primary transition-colors duration-150 ease-out group-hover:text-secondary sm:text-3xl xl:text-4xl">
									<a href={`/blog/${featuredPost.id}/`} class="text-inherit no-underline transition-none hover:text-inherit">{featuredPost.data.h1}</a>
								</h2>
								<p class="mt-4 line-clamp-2 text-sm leading-7 text-text-muted xl:text-base">{featuredPost.data.excerpt}</p>
								<a href={`/blog/${featuredPost.id}/`} class="mt-6 inline-flex w-fit items-center rounded-xl bg-secondary px-5 py-3 text-sm font-black text-white no-underline shadow-button transition-all duration-300 hover:-translate-y-0.5 hover:bg-secondary-dark hover:text-white active:translate-y-0">
									Leer artículo
								</a>
							</div>
						</article>
					</section>
				)}

				<section id="blog-grid" class="mt-14 grid gap-7 md:grid-cols-2 lg:grid-cols-3" aria-label="Artículos del blog">
					{regularPosts.map((post) => (
						<article class="blog-card group flex h-full flex-col overflow-hidden rounded-2xl bg-white/95 shadow-premium ring-1 ring-primary/5 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-premium-hover" data-category={categorySlug(post.data.category)}>
							<a href={`/blog/${post.id}/`} class="block overflow-hidden bg-bg-dark no-underline" aria-label={`Leer ${post.data.h1}`}>
								{post.data.image && (
									<img
										src={post.data.image}
										alt={post.data.imageAlt}
										width="1200"
										height="630"
										loading="lazy"
										decoding="async"
										class="aspect-[40/21] w-full object-cover transition-transform duration-700 group-hover:scale-[1.045]"
									/>
								)}
							</a>
							<div class="flex flex-1 flex-col p-7">
								<div class="flex items-center justify-between gap-4">
									<p class="m-0 text-[0.7rem] font-extrabold tracking-[0.16em] text-secondary">{categoryLabel(post.data.category)}</p>
									<span class="shrink-0 text-xs font-semibold text-text-muted">{formatDate(post.data.pubDate)}</span>
								</div>
								<h2 class="mt-5 text-balance text-2xl font-extrabold leading-tight text-primary transition-colors duration-150 ease-out group-hover:text-secondary">
									<a href={`/blog/${post.id}/`} class="text-inherit no-underline transition-none hover:text-inherit">{post.data.h1}</a>
								</h2>
								<p class="mt-4 line-clamp-3 flex-1 text-sm leading-7 text-text-muted">{post.data.excerpt}</p>
								<a href={`/blog/${post.id}/`} class="mt-7 inline-flex w-fit text-sm font-black text-secondary no-underline transition-colors hover:text-accent">
									Leer artículo
								</a>
							</div>
						</article>
					))}
				</section>
			</div>
		</section>
	</main>
	<script is:inline>
		const applyBlogFilter = (selectedCategory) => {
			const selected = selectedCategory || 'all';

			document.querySelectorAll('.blog-card').forEach((card) => {
				const shouldShow = selected === 'all' || card.getAttribute('data-category') === selected;
				card.classList.toggle('hidden', !shouldShow);
			});

			document.querySelectorAll('[data-category-filter]').forEach((button) => {
				const isActive = button.getAttribute('data-category-filter') === selected;
				button.classList.toggle('bg-white/90', !isActive);
				button.classList.toggle('text-primary', !isActive);
				button.classList.toggle('border-primary/10', !isActive);
				button.classList.toggle('bg-secondary', isActive);
				button.classList.toggle('text-white', isActive);
				button.classList.toggle('border-secondary', isActive);
				button.classList.toggle('shadow-premium-hover', isActive);
				button.setAttribute('aria-pressed', String(isActive));
			});
		};

		const getSelectedBlogCategory = () => new URLSearchParams(window.location.search).get('categoria') || 'all';

		const initBlogFilters = () => {
			const filterBar = document.querySelector('[data-blog-filters]');
			if (!filterBar || filterBar.dataset.bound === 'true') {
				applyBlogFilter(getSelectedBlogCategory());
				return;
			}

			filterBar.dataset.bound = 'true';
			filterBar.addEventListener('click', (event) => {
				const link = event.target instanceof Element ? event.target.closest('[data-category-filter]') : null;
				if (!(link instanceof HTMLAnchorElement)) return;

				event.preventDefault();
				const selected = link.getAttribute('data-category-filter') || 'all';
				const nextUrl = selected === 'all' ? '/blog/' : `/blog/?categoria=${selected}`;
				window.history.pushState({}, '', nextUrl);
				applyBlogFilter(selected);
			});

			applyBlogFilter(getSelectedBlogCategory());
		};

		document.addEventListener('astro:page-load', initBlogFilters);
		window.addEventListener('popstate', () => applyBlogFilter(getSelectedBlogCategory()));
		initBlogFilters();
	</script>
</BaseLayout>
